[Unit]
Description=Smart Greenhouse Automation — Remote USB Camera Streamer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/greenhouse
Environment=PYTHONUNBUFFERED=1
Environment=GREENHOUSE_CAMERA_URL=http://YOUR_SERVER_IP:5000/api/camera/frame
Environment=CAMERA_INDEX=0
Environment=CAMERA_FPS=3.0
ExecStart=/usr/bin/python3 /home/pi/greenhouse/rpi_camera_streamer.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
